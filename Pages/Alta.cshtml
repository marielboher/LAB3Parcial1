@page
@model AltaModel
@{
    ViewData["Title"] = "Alta de productos";
}

<div class="page-header">
    <h1>Alta de productos</h1>
    <p class="text-muted">Complete los datos para cargar un nuevo producto.</p>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success">@Model.Mensaje</div>
}

<div class="card-panel col-lg-6">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Producto.Nombre" class="form-label"></label>
            <input asp-for="Producto.Nombre" class="form-control" placeholder="Ej: Mouse Logitech G203" />
            <span asp-validation-for="Producto.Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Producto.Precio" class="form-label"></label>
            <input asp-for="Producto.Precio" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" required />
            <span asp-validation-for="Producto.Precio" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Producto.IdCategoria" class="form-label"></label>
            <select asp-for="Producto.IdCategoria" asp-items="Model.Categorias" class="form-select">
                <option value="">-- Seleccione --</option>
            </select>
            <span asp-validation-for="Producto.IdCategoria" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Confirmar</button>
    </form>
</div>

<a asp-page="/Index" class="link-volver">&larr; Volver a la página principal</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
