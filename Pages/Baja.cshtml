@page
@model BajaModel
@{
    ViewData["Title"] = "Baja de productos";
}

<div class="page-header">
    <h1>Baja de productos</h1>
    <p class="text-muted">Seleccione los productos a eliminar. Las categorías no se modifican.</p>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success">@Model.Mensaje</div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="card-panel">
    @if (Model.Productos.Count == 0)
    {
        <div class="alert alert-info mb-0">No hay productos cargados.</div>
    }
    else
    {
        <form method="post" id="form-baja">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th class="col-check"></th>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th class="text-end">Precio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var producto in Model.Productos)
                        {
                            var idCheck = $"producto-{producto.IdProducto}";
                            <tr>
                                <td class="col-check">
                                    <input type="checkbox" class="form-check-input" id="@idCheck"
                                           name="Seleccionados" value="@producto.IdProducto"
                                           data-nombre="@producto.Nombre" />
                                </td>
                                <td>@producto.IdProducto</td>
                                <td><label for="@idCheck" class="mb-0">@producto.Nombre</label></td>
                                <td><span class="badge-categoria">@producto.Categoria</span></td>
                                <td class="text-end text-nowrap">@producto.PrecioTexto</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <button type="submit" class="btn btn-danger">Eliminar seleccionados</button>
        </form>
    }
</div>

<a asp-page="/Index" class="link-volver">&larr; Volver a la página principal</a>

@section Scripts {
    <script>
        document.getElementById("form-baja")?.addEventListener("submit", function (evento) {
            const marcados = Array.from(this.querySelectorAll("input[name='Seleccionados']:checked"));

            if (marcados.length === 0) {
                evento.preventDefault();
                alert("Seleccione al menos un producto para eliminar.");
                return;
            }

            const nombres = marcados.map(c => "- " + c.dataset.nombre).join("\n");
            const pregunta = marcados.length === 1
                ? "¿Está seguro de que desea eliminar el siguiente producto?"
                : `¿Está seguro de que desea eliminar los siguientes ${marcados.length} productos?`;

            if (!confirm(`${pregunta}\n\n${nombres}\n\nEsta acción no se puede deshacer.`)) {
                evento.preventDefault();
            }
        });
    </script>
}
