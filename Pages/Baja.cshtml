@page
@model BajaModel
@{
    ViewData["Title"] = "Baja de productos";
}

<div class="page-header">
    <h1>Baja de productos</h1>
    <p class="text-muted">Seleccione los productos a eliminar. Las categorías no se modifican.</p>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success">@Model.Mensaje</div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

@if (Model.Confirmando)
{
    <div class="card-panel panel-peligro">
        <h2 class="h5 mb-3">¿Está seguro de que desea eliminar @(Model.Productos.Count == 1 ? "el siguiente producto" : $"los siguientes {Model.Productos.Count} productos")?</h2>
        <ul class="mb-3">
            @foreach (var producto in Model.Productos)
            {
                <li><strong>@producto.Nombre</strong> (@producto.Categoria) - @producto.PrecioTexto</li>
            }
        </ul>
        <p class="text-muted small">Esta acción no se puede deshacer.</p>

        <form method="post" asp-page-handler="Confirmar" class="d-flex gap-2">
            @foreach (var producto in Model.Productos)
            {
                <input type="hidden" name="Seleccionados" value="@producto.IdProducto" />
            }
            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
            <a asp-page="/Baja" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
}
else
{
    <div class="card-panel">
        @if (Model.Productos.Count == 0)
        {
            <div class="alert alert-info mb-0">No hay productos cargados.</div>
        }
        else
        {
            <form method="post" asp-page-handler="Seleccionar">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th class="col-check"></th>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Categoría</th>
                                <th class="text-end">Precio</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var producto in Model.Productos)
                            {
                                var idCheck = $"producto-{producto.IdProducto}";
                                <tr>
                                    <td class="col-check">
                                        <input type="checkbox" class="form-check-input" id="@idCheck"
                                               name="Seleccionados" value="@producto.IdProducto"
                                               checked="@Model.Seleccionados.Contains(producto.IdProducto)" />
                                    </td>
                                    <td>@producto.IdProducto</td>
                                    <td><label for="@idCheck" class="mb-0">@producto.Nombre</label></td>
                                    <td><span class="badge-categoria">@producto.Categoria</span></td>
                                    <td class="text-end text-nowrap">@producto.PrecioTexto</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <button type="submit" class="btn btn-danger">Eliminar seleccionados</button>
            </form>
        }
    </div>
}

<a asp-page="/Index" class="link-volver">&larr; Volver a la página principal</a>
